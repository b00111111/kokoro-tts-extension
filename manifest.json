{
  "manifest_version": 3,
  "name": "Kokoro TTS",
  "short_name": "Kokoro TTS",
  "version": "1.1.0",
  "description": "Highlight text on any webpage and hear it read aloud using your local Kokoro TTS API.",

  "permissions": ["contextMenus", "storage", "tabs", "notifications", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Kokoro TTS Settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "commands": {
    "synthesize-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Read selected text with Kokoro TTS"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
